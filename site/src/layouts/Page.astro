---
import { site, pagePath, isPreview } from '../lib/settings.mjs';
import '../styles/global.css';
import TechnologyBackdrop from '../components/TechnologyBackdrop.astro';
import Analytics from '../components/Analytics.astro';
import Seo from '../components/Seo.astro';
import githubAvatar from '../assets/github-avatar.png';
const { title = site.title, description = site.description, path = pagePath(), article = false, publishedAt, images = [] } = Astro.props;
const preview = isPreview();
const aboutPath = pagePath('about/');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={githubAvatar.src} />
    <Seo {title} {description} {path} {publishedAt} {images} />
    <Analytics />
  </head>
  <body>
    <TechnologyBackdrop article={article} />
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <a class="wordmark" href={pagePath()} aria-label="Study 홈">Study<span aria-hidden="true">.</span></a>
      <nav class="site-nav" aria-label="주 메뉴">
        <a class="about-link" href={aboutPath} aria-current={path === aboutPath ? 'page' : undefined}>About Me</a>
        <a class="author" href="https://github.com/kangjuhyup">{site.author} ↗</a>
      </nav>
    </header>
    {preview && <div class="preview-banner">로컬 미리보기 · 아직 공개하지 않은 글이 포함되어 있습니다.</div>}
    <main id="main"><slot /></main>
    <footer class="site-footer"><span>Study · {site.author}</span><a href="https://github.com/kangjuhyup/study">학습 저장소 ↗</a></footer>
  </body>
</html>
