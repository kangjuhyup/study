---
import node from '../assets/technology/nodedotjs.svg?raw';
import typescript from '../assets/technology/typescript.svg?raw';
import docker from '../assets/technology/docker.svg?raw';
import postgres from '../assets/technology/postgresql.svg?raw';
import redis from '../assets/technology/redis.svg?raw';
import k6 from '../assets/technology/k6.svg?raw';
import envoy from '../assets/technology/envoyproxy.svg?raw';
import istio from '../assets/technology/istio.svg?raw';
import kubernetes from '../assets/technology/kubernetes.svg?raw';
import k3s from '../assets/technology/k3s.svg?raw';
import argo from '../assets/technology/argo.svg?raw';
import ansible from '../assets/technology/ansible.svg?raw';
import terraform from '../assets/technology/terraform.svg?raw';
import githubactions from '../assets/technology/githubactions.svg?raw';
import prometheus from '../assets/technology/prometheus.svg?raw';
import grafana from '../assets/technology/grafana.svg?raw';
import etcd from '../assets/technology/etcd.svg?raw';
import certmanager from '../assets/technology/certmanager.svg?raw';
import cloudnativepg from '../assets/technology/cloudnativepg.svg?raw';
import k0s from '../assets/technology/k0s.svg?raw';
import helm from '../assets/technology/helm.svg?raw';
import ubuntu from '../assets/technology/ubuntu.svg?raw';
import oracle from '../assets/technology/oracle.svg?raw';
const { article = false } = Astro.props;
const infrastructure = Astro.url.pathname.replace(/\/$/, '').endsWith('/posts/oracle-a1-k3s-gitops');
const icons = infrastructure
  ? [k3s, argo, ansible, terraform, githubactions, prometheus, grafana, etcd, certmanager, cloudnativepg, k0s, helm, ubuntu, oracle]
  : [node, typescript, docker, postgres, redis, k6, envoy, istio, kubernetes];
---
<div class:list={['technology-backdrop', { 'reading-backdrop': article, 'infrastructure-backdrop': infrastructure }]} aria-hidden="true">
  {icons.map((icon, index) => <span class={`technology-mark mark-${index}`} set:html={icon} />)}
</div>
<style>
  .technology-backdrop {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
    color: #527da9;
  }
  .technology-mark {
    position: absolute;
    width: clamp(80px, 9vw, 130px);
    opacity: .13;
    transform: rotate(var(--tilt, 0deg));
  }
  .technology-mark :global(svg) { display: block; width: 100%; height: auto; fill: currentColor; }
  .mark-0 { left: calc(50% - 580px); top: 14%; --tilt: -12deg; }
  .mark-1 { right: calc(50% - 560px); top: 11%; --tilt: 12deg; }
  .mark-2 { left: calc(50% - 490px); top: 52%; --tilt: -8deg; }
  .mark-3 { right: calc(50% - 535px); top: 47%; --tilt: 10deg; }
  .mark-4 { left: calc(50% - 590px); top: 83%; --tilt: 10deg; }
  .mark-5 { right: calc(50% - 470px); top: 84%; --tilt: -12deg; }
  .mark-6 { left: calc(50% - 535px); top: 34%; --tilt: 8deg; }
  .mark-7 { right: calc(50% - 575px); top: 67%; --tilt: -8deg; }
  .mark-8 { left: calc(50% - 485px); top: 96%; --tilt: 12deg; }
  .reading-backdrop .technology-mark { opacity: .05; }
  @media (max-width: 1100px) {
    .mark-0,.mark-4 { left: -24px; }
    .mark-2 { left: 12px; }
    .mark-1,.mark-3 { right: -20px; }
    .mark-5 { right: 16px; }
    .mark-6,.mark-8 { left: -24px; }
    .mark-7 { right: -20px; }
  }
  @media (max-width: 600px) {
    .technology-mark { width: 90px; opacity: .10; }
    .mark-2 { top: 69%; left: -22px; }
    .mark-6 { top: 12%; left: -32px; }
    .mark-7 { top: 36%; right: -22px; }
    .mark-0,.mark-1,.mark-3,.mark-4,.mark-5,.mark-8 { display: none; }
    .reading-backdrop .technology-mark { opacity: .03; }
  }

  .infrastructure-backdrop .technology-mark { width: clamp(54px, 5vw, 72px); }
  .infrastructure-backdrop .mark-0 { left: auto; right: auto; left: calc(50% - 555px); top: 7%; }
  .infrastructure-backdrop .mark-1 { left: auto; right: auto; right: calc(50% - 555px); top: 7%; }
  .infrastructure-backdrop .mark-2 { left: auto; right: auto; left: calc(50% - 555px); top: 20%; }
  .infrastructure-backdrop .mark-3 { left: auto; right: auto; right: calc(50% - 555px); top: 20%; }
  .infrastructure-backdrop .mark-4 { left: auto; right: auto; left: calc(50% - 555px); top: 33%; }
  .infrastructure-backdrop .mark-5 { left: auto; right: auto; right: calc(50% - 555px); top: 33%; }
  .infrastructure-backdrop .mark-6 { left: auto; right: auto; left: calc(50% - 555px); top: 46%; }
  .infrastructure-backdrop .mark-7 { left: auto; right: auto; right: calc(50% - 555px); top: 46%; }
  .infrastructure-backdrop .mark-8 { left: auto; right: auto; left: calc(50% - 555px); top: 59%; }
  .infrastructure-backdrop .mark-9 { left: auto; right: auto; right: calc(50% - 555px); top: 59%; }
  .infrastructure-backdrop .mark-10 { left: auto; right: auto; left: calc(50% - 555px); top: 72%; }
  .infrastructure-backdrop .mark-11 { left: auto; right: auto; right: calc(50% - 555px); top: 72%; }
  .infrastructure-backdrop .mark-12 { left: auto; right: auto; left: calc(50% - 555px); top: 85%; }
  .infrastructure-backdrop .mark-13 { left: auto; right: auto; right: calc(50% - 555px); top: 85%; }
  @media (max-width: 1100px) {
    .infrastructure-backdrop .technology-mark:nth-child(odd) { left: -18px; right: auto; }
    .infrastructure-backdrop .technology-mark:nth-child(even) { right: -18px; left: auto; }
    .infrastructure-backdrop .technology-mark:nth-child(n+9) { display: none; }
  }
  @media (max-width: 600px) {
    .infrastructure-backdrop .technology-mark { display: none; }
    .infrastructure-backdrop .mark-0 { display: block; top: 12%; }
    .infrastructure-backdrop .mark-1 { display: block; top: 38%; }
    .infrastructure-backdrop .mark-5 { display: block; top: 72%; }
  }
  @media (prefers-reduced-transparency: reduce), (forced-colors: active) {
    .technology-backdrop { display: none; }
  }
</style>
