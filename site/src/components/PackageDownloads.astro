---
const { stats } = Astro.props;
const number = new Intl.NumberFormat('ko-KR');
---
{stats ? (
  <div class="package-downloads">
    <dl>
      <div><dt>누적 다운로드</dt><dd>{number.format(stats.total)}</dd></div>
    </dl>
    {stats.packageCount > 1 && <small class="package-count">{stats.packageCount}개 패키지 합산</small>}
    <small>npm · <time datetime={stats.end}>{stats.end}</time> 기준</small>
  </div>
) : <small class="downloads-unavailable">다운로드 통계를 일시적으로 조회할 수 없습니다.</small>}

<style>
  .package-downloads { margin: 2px 0 12px; padding-top: 12px; border-top: 1px solid var(--line); }
  dl { display: flex; flex-wrap: wrap; gap: 12px 26px; margin: 0 0 8px; }
  dt { color: var(--muted); font-size: 11px; line-height: 1.5; }
  dd { margin: 3px 0 0; color: var(--ink); font-size: 21px; font-weight: 700; line-height: 1.3; font-variant-numeric: tabular-nums; }
  small { color: var(--muted); font-size: 10px; line-height: 1.6; }
  .package-count { display: block; margin-bottom: 3px; }
  .downloads-unavailable { display: block; margin-bottom: 12px; }
</style>
