---
import { site, pagePath, absoluteURL, isPreview } from '../lib/settings.mjs';
import githubAvatar from '../assets/github-avatar.png';

const { title = site.title, description = site.description, path = pagePath(), publishedAt, images = [] } = Astro.props;
const preview = isPreview();
const canonical = absoluteURL(path);
const aboutURL = absoluteURL(pagePath('about/'));
const isPost = Boolean(publishedAt);
const pageTitle = title === site.title ? `${site.title} · ${site.author}의 개발 학습 기록` : `${title} · ${site.title}`;
const shareImage = images[0] ?? { src: githubAvatar.src, alt: `${site.author}의 프로필 이미지` };
const verification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '').trim();
const page = {
  '@type': isPost ? 'BlogPosting' : path === pagePath('about/') ? 'AboutPage' : 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ko-KR',
  ...(isPost && {
    headline: title,
    datePublished: publishedAt,
    mainEntityOfPage: canonical,
    author: { '@type': 'Person', name: site.author, url: aboutURL },
    ...(images.length > 0 && { image: images.map(image => absoluteURL(image.src)) }),
  }),
};
const graph = [page];
if (path !== pagePath()) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.title, item: absoluteURL() },
      { '@type': 'ListItem', position: 2, name: title, item: canonical },
    ],
  });
}
// script 안에서도 본문에 포함된 </script>를 문자열로 유지합니다.
const jsonLD = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author} />
{preview ? <meta name="robots" content="noindex, nofollow" /> : (
  <>
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    {verification && <meta name="google-site-verification" content={verification} />}
    <script type="application/ld+json" is:inline set:html={jsonLD} />
  </>
)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={isPost ? 'article' : 'website'} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:site_name" content={site.title} />
<meta name="twitter:card" content={images.length > 0 ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{!preview && (
  <>
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteURL(shareImage.src)} />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:image" content={absoluteURL(shareImage.src)} />
    <meta name="twitter:image:alt" content={shareImage.alt} />
    {isPost && <meta property="article:published_time" content={publishedAt} />}
    {isPost && <meta property="article:author" content={aboutURL} />}
  </>
)}
