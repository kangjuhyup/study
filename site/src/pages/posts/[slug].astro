---
import Page from '../../layouts/Page.astro';
import { loadBlog } from '../../lib/blog.mjs';
import { site, pagePath, isPreview } from '../../lib/settings.mjs';
export async function getStaticPaths() {
  const { posts } = await loadBlog();
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<Page title={post.title} description={post.description} path={post.path} article>
  <article class="article">
    <header class="article-header">
      <a class="back-link" href={pagePath()}>← 학습 기록</a>
      <p class="eyebrow">{post.draft ? 'DRAFT · 초안' : 'LEARNING NOTES'}</p>
      <h1>{post.title}</h1>
      <p class="article-meta"><span>{site.author}</span>{post.publishedAt && <time datetime={post.publishedAt}>{post.publishedAt}</time>}</p>
    </header>
    {post.headings.length > 0 && <nav class="toc" aria-label="목차">
      <h2>이 글에서</h2>
      <ol>{post.headings.filter(heading => heading.level === 2).map(heading => <li><a href={`#${heading.id}`}>{heading.text}</a></li>)}</ol>
    </nav>}
    <div class="prose" set:html={post.html} />
    {!isPreview() && !post.draft && <section class="comments" aria-label="댓글">
      <header class="comments-header">
        <div>
          <h2>이야기 나누기</h2>
          <p>궁금한 점이나 다른 경험이 있다면 남겨 주세요.</p>
        </div>
        <a class="comments-link" href={`https://github.com/kangjuhyup/study/issues?q=${encodeURIComponent(`is:issue "${post.path}"`)}`}>GitHub에서 보기 <span aria-hidden="true">↗</span></a>
      </header>
      <div class="comments-panel">
      <script is:inline src="https://utteranc.es/client.js"
        repo="kangjuhyup/study"
        issue-term="pathname"
        theme="github-light"
        crossorigin="anonymous"
        async></script>
      <noscript>댓글을 보려면 JavaScript를 켜 주세요.</noscript>
      </div>
      <p class="comments-note">GitHub 로그인 후 작성할 수 있어요. 댓글은 공개 이슈에 함께 기록됩니다.</p>
    </section>}
    <a class="back-link article-end" href={pagePath()}>← 다른 학습 기록 보기</a>
  </article>
</Page>

<style>
  .comments { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .comments-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .comments h2 { margin: 0; font-size: 1.25rem; line-height: 1.5; letter-spacing: -.035em; }
  .comments-header p { margin: .5rem 0 0; color: var(--muted); font-size: .875rem; line-height: 1.7; }
  .comments-link { flex-shrink: 0; padding-block: .4rem; color: var(--accent); font-size: .75rem; line-height: 1.6; text-decoration: none; }
  .comments-link:hover { text-decoration: underline; }
  .comments-panel { padding: 1rem; background: #fff; border: 1px solid var(--line); border-radius: 8px; }
  .comments-note { margin: .75rem 0 0; color: var(--muted); font-size: .75rem; line-height: 1.7; }
  .comments :global(.utterances) { max-width: 100%; margin: 0; }
  @media (max-width: 600px) {
    .comments { margin-top: 3rem; }
    .comments-header { flex-direction: column; gap: .5rem; }
    .comments-panel { padding: .5rem; }
  }
</style>
